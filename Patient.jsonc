{
  "name": "Patient",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nome"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "title": "Data de Nascimento"
    },
    "gender": {
      "type": "string",
      "enum": [
        "masculino",
        "feminino",
        "outro"
      ],
      "title": "Sexo"
    },
    "phone": {
      "type": "string",
      "title": "Telefone"
    },
    "email": {
      "type": "string",
      "title": "E-mail"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "name"
  ]
}
